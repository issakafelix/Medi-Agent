# Environment Variables Template

# API Configuration
# Production (recommended): serve frontend from backend and use same-origin API
VITE_API_URL=/api
VITE_API_TIMEOUT=30000

# App Configuration
VITE_APP_NAME=Claude AI Assistant
VITE_APP_VERSION=1.0.0
VITE_APP_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_VOICE_INPUT=true
VITE_ENABLE_CODE_HIGHLIGHTING=true
VITE_ENABLE_CHAT_HISTORY=true

# Analytics (Optional)
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# UI Configuration
VITE_DEFAULT_DARK_MODE=false
VITE_MESSAGE_SEND_ANIMATION_DURATION=300
VITE_TYPING_INDICATOR_SHOW_DURATION=1500

# Note: In production, use environment-specific files:
# .env                    (default)
# .env.development        (npm run dev)
# .env.production         (npm run build)
