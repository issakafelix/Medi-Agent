# Backend environment variables (copy to backend/.env and edit)

# App settings
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=3001

# API / CORS
CORS_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=*

# Database (default: local sqlite)
DATABASE_URL=sqlite:///./app.db

# Upload/rate limits
MAX_UPLOAD_BYTES=5242880
RATE_LIMIT_PER_MINUTE=60

# LLM Provider settings (set to enable real AI features)
# Options: disabled | openai-compatible | gemini
LLM_PROVIDER=disabled
LLM_REQUEST_TIMEOUT_S=45.0
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024

# Firebase service account JSON (optional). For production, set this to the
# full JSON string of your Firebase service account. When empty, the backend
# falls back to a lightweight development user so local development works
# without requiring Firebase authentication.
FIREBASE_SERVICE_ACCOUNT_JSON=
# You can set FIREBASE_SERVICE_ACCOUNT_JSON to either:
# 1) the full JSON string of the service account (suitable for Render/Heroku env vars)
# 2) a relative/absolute path to a local file containing the JSON (useful for local dev),
#    e.g. FIREBASE_SERVICE_ACCOUNT_JSON=backend/service-account.json

# Note:
# - Copy this file to backend/.env and edit values for your environment.
# - In production set APP_ENV=prod and provide FIREBASE_SERVICE_ACCOUNT_JSON
#   to enable real authentication and user verification.
